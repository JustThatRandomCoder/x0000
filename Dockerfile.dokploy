# --- STAGE 1: Die Anwendung bauen ---
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable

# Node-Abhängigkeiten installieren
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# Quellcode kopieren und das statische 'dist/' Verzeichnis generieren
COPY . .
ENV NODE_ENV=production
RUN pnpm run build

# --- STAGE 2: Reiner statischer Webserver (Caddy) ---
FROM caddy:2-alpine AS dokploy

# Kopiere die fertigen HTML/CSS/JS Dateien aus der Build-Stage
COPY --from=build /app/dist /usr/share/caddy

# Port 80 freigeben (Standard für Webserver)
EXPOSE 80

# Caddy startet automatisch und liefert den Ordner ohne Konfiguration perfekt aus
CMD ["caddy", "file-server", "--root", "/usr/share/caddy", "--listen", ":80"]
